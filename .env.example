# Скопируйте этот файл в .env и поправьте. Всё, что не заполнено, можно подключить потом прямо в приложении.

# Адрес, по которому вы будете открывать приложение (нужен для Docker + HTTPS и ссылок в Telegram)
LS_DOMAIN=scout.example.com
LS_PUBLIC_URL=https://scout.example.com

# Пароль для входа. Если не задать, он создастся сам и будет записан в /data/password.txt
LS_PASSWORD=

# Ваш часовой пояс
LS_TZ=Europe/Moscow

# Всё ниже необязательно: подключается в приложении, раздел «Профиль» → «Подключения»
# ANTHROPIC_API_KEY=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=

# Как часто проверять чаты, минут
LS_SCAN_MINUTES=10
# Курсы для пересчёта бюджетов в рубли
LS_USD_RUB=95
LS_EUR_RUB=105
